---
interface Props {
  src: string;
  title?: string;
}

const { src, title = 'Embedded media' } = Astro.props;
---

<div class="responsive-embed">
  <iframe
    src={src}
    title={title}
    loading="lazy"
    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
    allowfullscreen></iframe>
</div>
