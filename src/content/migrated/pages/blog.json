  "bodyHtml": "<main class=\"main\"><section  class=\"cb-articles-grid cb-articles-grid--type-two cb-articles-grid--align-leftcb-articles-grid--type-two--highlight-latest\" style=\"\"><div class=\"cb-articles-grid__container padding-top-md padding-bottom-md\"><h2 class=\"cb-articles-grid__heading\">\nLatest posts</h2><div class=\"cb-articles-grid__items\" data-items=\"8\" data-module-type=\"--type-two\" data-post-type=\"blog-posts\"><article class=\"c-article-item\">\n<a class=\"c-article-item__link\" href=\"/blog/why-ai-gave-us-all-whiplash/\"><div class=\"c-article-item__image\">\n<img data-lazyloaded=\"1\" src=\"/media/2023/07/robot-in-space.png\" width=\"768\" height=\"768\" data-src=\"/media/2023/07/robot-in-space.png\" class=\"attachment-large size-large\" alt=\"Robot flying through space painting generated by AI DALL-E\" decoding=\"async\" data-srcset=\"/media/2023/07/robot-in-space.png 768w, /media/2023/07/robot-in-space-300x300.png 300w, /media/2023/07/robot-in-space-150x150.png 150w\" data-sizes=\"(max-width: 768px) 100vw, 768px\" / srcset=\"/media/2023/07/robot-in-space.png 768w, /media/2023/07/robot-in-space-300x300.png 300w, /media/2023/07/robot-in-space-150x150.png 150w\"></div><p class=\"c-article-item__date\">20.07.23</p><div class=\"c-article-item__text\"><h3 class=\"c-article-item__title\">Why AI gave us all whiplash</h3><p class=\"c-article-item__excerpt\">Exploring why AI feels like it came out of nowhere.</p></div>\n</a></article><article class=\"c-article-item\">\n<a class=\"c-article-item__link\" href=\"/blog/ai-adventures-how-i-built-a-text-based-rpg/\"><div class=\"c-article-item__image\">\n<img data-lazyloaded=\"1\" src=\"/media/2023/05/FableForge-1024x783.png\" width=\"1024\" height=\"783\" data-src=\"/media/2023/05/FableForge-1024x783.png\" class=\"attachment-large size-large\" alt=\"Screenshot of FableForge.ai, a ChatGPT OpenAI, DALL-E project\" decoding=\"async\" data-srcset=\"/media/2023/05/FableForge-1024x783.png 1024w, /media/2023/05/FableForge-300x229.png 300w, /media/2023/05/FableForge-768x587.png 768w, /media/2023/05/FableForge.png 1444w\" data-sizes=\"(max-width: 1024px) 100vw, 1024px\" / srcset=\"/media/2023/05/FableForge-1024x783.png 1024w, /media/2023/05/FableForge-300x229.png 300w, /media/2023/05/FableForge-768x587.png 768w, /media/2023/05/FableForge.png 1444w\"></div><p class=\"c-article-item__date\">12.05.23</p><div class=\"c-article-item__text\"><h3 class=\"c-article-item__title\">AI Adventures: How I Built a Text-Based RPG</h3><p class=\"c-article-item__excerpt\">My story of creating a text based RPG to win a competition.</p></div>\n</a></article><article class=\"c-article-item\">\n<a class=\"c-article-item__link\" href=\"/blog/my-react-projects/\"><div class=\"c-article-item__image\">\n<img data-lazyloaded=\"1\" src=\"/media/2022/12/tenzies.png\" width=\"705\" height=\"528\" data-src=\"/media/2022/12/tenzies.png\" class=\"attachment-large size-large\" alt=\"Screenshot of my React JS project called Tenzies\" decoding=\"async\" data-srcset=\"/media/2022/12/tenzies.png 705w, /media/2022/12/tenzies-300x225.png 300w\" data-sizes=\"(max-width: 705px) 100vw, 705px\" / srcset=\"/media/2022/12/tenzies.png 705w, /media/2022/12/tenzies-300x225.png 300w\"></div><p class=\"c-article-item__date\">07.12.22</p><div class=\"c-article-item__text\"><h3 class=\"c-article-item__title\">My React Projects</h3><p class=\"c-article-item__excerpt\">Collection of my React JS projects.</p></div>\n</a></article><article class=\"c-article-item\">\n<a class=\"c-article-item__link\" href=\"/blog/glassmorphism/\"><div class=\"c-article-item__image\">\n<img data-lazyloaded=\"1\" src=\"/media/2022/10/Screenshot-2022-10-05-at-15.25.35.png\" width=\"784\" height=\"509\" data-src=\"/media/2022/10/Screenshot-2022-10-05-at-15.25.35.png\" class=\"attachment-large size-large\" alt=\"Glassmorphism example image for tutorial\" decoding=\"async\" data-srcset=\"/media/2022/10/Screenshot-2022-10-05-at-15.25.35.png 784w, /media/